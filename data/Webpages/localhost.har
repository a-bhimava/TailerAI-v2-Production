            "compression": 0,
            "text": "/* Layout Styles for TailerAI v2.0 */\n\n/* =============================================================================\n   APP SHELL LAYOUT\n   ============================================================================= */\n\n.app-shell {\n    display: grid;\n    grid-template-areas: \n        \"header\"\n        \"main\"\n        \"status\";\n    grid-template-columns: 1fr;\n    grid-template-rows: var(--header-height) 1fr var(--status-bar-height);\n    min-height: 100vh;\n    overflow: visible;\n    position: relative;\n}\n\n.app-shell.sidebar-open {\n    grid-template-areas: \n        \"header\"\n        \"main\"\n        \"status\";\n    grid-template-columns: 1fr;\n    /* Sidebar will overlay, not change grid */\n}\n\n/* =============================================================================\n   HEADER\n   ============================================================================= */\n\n.app-header {\n    grid-area: header;\n    background-color: var(--bg-primary);\n    border-bottom: 1px solid var(--border-light);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 var(--space-6);\n    position: relative;\n    z-index: 100;\n}\n\n.header-left {\n    display: flex;\n    align-items: center;\n    gap: var(--space-4);\n}\n\n.sidebar-toggle {\n    width: 40px;\n    height: 40px;\n    border-radius: var(--radius-lg);\n    background-color: transparent;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all var(--transition-fast);\n    border: none;\n    cursor: pointer;\n}\n\n.sidebar-toggle:hover {\n    background-color: var(--bg-secondary);\n}\n\n.sidebar-toggle:focus {\n    outline: 2px solid var(--accent-primary);\n    outline-offset: 2px;\n}\n\n.hamburger {\n    width: 20px;\n    height: 2px;\n    background-color: var(--text-primary);\n    position: relative;\n    transition: all var(--transition-fast);\n    border-radius: 1px;\n}\n\n.hamburger::before,\n.hamburger::after {\n    content: '';\n    position: absolute;\n    width: 20px;\n    height: 2px;\n    background-color: var(--text-primary);\n    transition: all var(--transition-fast);\n    border-radius: 1px;\n}\n\n.hamburger::before {\n    top: -6px;\n}\n\n.hamburger::after {\n    top: 6px;\n}\n\n/* Animated hamburger when sidebar is open */\n.sidebar-toggle.active .hamburger {\n    background-color: transparent;\n}\n\n.sidebar-toggle.active .hamburger::before {\n    top: 0;\n    transform: rotate(45deg);\n}\n\n.sidebar-toggle.active .hamburger::after {\n    top: 0;\n    transform: rotate(-45deg);\n}\n\n.app-logo h1 {\n    font-size: var(--font-size-xl);\n    font-weight: var(--font-weight-bold);\n    color: var(--accent-primary);\n    line-height: 1;\n}\n\n.app-subtitle {\n    font-size: var(--font-size-xs);\n    color: var(--text-tertiary);\n    margin-top: var(--space-1);\n}\n\n.header-center {\n    flex: 1;\n    display: flex;\n    justify-content: center;\n}\n\n.breadcrumb {\n    display: flex;\n    align-items: center;\n    gap: var(--space-2);\n}\n\n.breadcrumb-item {\n    font-size: var(--font-size-sm);\n    color: var(--text-tertiary);\n    position: relative;\n}\n\n.breadcrumb-item.active {\n    color: var(--text-primary);\n    font-weight: var(--font-weight-medium);\n}\n\n.breadcrumb-item:not(:last-child)::after {\n    content: '›';\n    position: absolute;\n    right: -0.75rem;\n    color: var(--text-muted);\n}\n\n.header-right {\n    display: flex;\n    align-items: center;\n    gap: var(--space-4);\n}\n\n.user-menu {\n    position: relative;\n}\n\n.user-avatar {\n    width: 40px;\n    height: 40px;\n    border-radius: var(--radius-full);\n    background-color: var(--accent-primary);\n    color: var(--text-inverse);\n    font-weight: var(--font-weight-medium);\n    font-size: var(--font-size-sm);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all var(--transition-fast);\n    cursor: pointer;\n}\n\n.user-avatar:hover {\n    background-color: var(--primary-700);\n    transform: scale(1.05);\n}\n\n.user-dropdown {\n    position: absolute;\n    top: 100%;\n    right: 0;\n    margin-top: var(--space-2);\n    background-color: var(--bg-primary);\n    border: 1px solid var(--border-light);\n    border-radius: var(--radius-lg);\n    box-shadow: var(--shadow-lg);\n    min-width: 200px;\n    padding: var(--space-3);\n    opacity: 0;\n    visibility: hidden;\n    transform: translateY(-10px);\n    transition: all var(--transition-fast);\n    z-index: var(--z-dropdown);\n}\n\n.user-dropdown.active {\n    opacity: 1;\n    visibility: visible;\n    transform: translateY(0);\n}\n\n.user-info {\n    padding: var(--space-2) 0;\n}\n\n.user-name {\n    font-weight: var(--font-weight-medium);\n    color: var(--text-primary);\n    font-size: var(--font-size-sm);\n}\n\n.user-email {\n    color: var(--text-tertiary);\n    font-size: var(--font-size-xs);\n    margin-top: var(--space-1);\n}\n\n.user-dropdown button {\n    width: 100%;\n    text-align: left;\n    padding: var(--space-2) var(--space-3);\n    border-radius: var(--radius-md);\n    color: var(--text-secondary);\n    font-size: var(--font-size-sm);\n    transition: all var(--transition-fast);\n}\n\n.user-dropdown button:hover {\n    background-color: var(--bg-secondary);\n    color: var(--text-primary);\n}\n\n/* =============================================================================\n   SIDEBAR\n   ============================================================================= */\n\n.app-sidebar {\n    position: fixed;\n    top: var(--header-height);\n    left: -280px;\n    width: var(--sidebar-width);\n    height: calc(100vh - var(--header-height) - var(--status-bar-height));\n    background-color: var(--bg-secondary);\n    border-right: 1px solid var(--border-light);\n    display: flex;\n    flex-direction: column;\n    overflow-y: auto;\n    transition: all var(--transition-normal);\n    z-index: var(--z-dropdown);\n    box-shadow: var(--shadow-lg);\n}\n\n.app-sidebar.open {\n    left: 0;\n}\n\n.sidebar-content {\n    padding: var(--space-6) var(--space-4);\n}\n\n.nav-menu {\n    display: flex;\n    flex-direction: column;\n    gap: var(--space-2);\n}\n\n.nav-item {\n    width: 100%;\n}\n\n.nav-link {\n    display: flex;\n    align-items: center;\n    gap: var(--space-3);\n    width: 100%;\n    padding: var(--space-3) var(--space-4);\n    border-radius: var(--radius-lg);\n    color: var(--text-secondary);\n    font-size: var(--font-size-sm);\n    font-weight: var(--font-weight-medium);\n    transition: all var(--transition-fast);\n    text-align: left;\n}\n\n.nav-link:hover {\n    background-color: var(--bg-accent);\n    color: var(--accent-primary);\n    transform: translateX(4px);\n}\n\n.nav-link.active {\n    background-color: var(--accent-primary);\n    color: var(--text-inverse);\n    box-shadow: var(--shadow-md);\n}\n\n.nav-icon {\n    font-size: var(--font-size-lg);\n    width: 24px;\n    text-align: center;\n}\n\n.nav-text {\n    transition: opacity var(--transition-normal);\n}\n\n/* Sidebar Overlay */\n.sidebar-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-color: rgba(0, 0, 0, 0.5);\n    z-index: calc(var(--z-dropdown) - 1);\n    opacity: 0;\n    visibility: hidden;\n    transition: all var(--transition-normal);\n}\n\n.sidebar-overlay.active {\n    opacity: 1;\n    visibility: visible;\n}\n\n/* All screen sizes - sidebar always collapsible */\n.sidebar-toggle {\n    display: flex;\n}\n\n/* =============================================================================\n   MAIN CONTENT\n   ============================================================================= */\n\n.app-main {\n    grid-area: main;\n    background-color: var(--bg-primary);\n    overflow-y: auto;\n    position: relative;\n}\n\n.view {\n    padding: var(--space-8);\n    opacity: 0;\n    transform: translateY(20px);\n    transition: all var(--transition-normal);\n    display: none;\n}\n\n.view.active {\n    opacity: 1;\n    transform: translateY(0);\n    display: block;\n}\n\n.page-header {\n    margin-bottom: var(--space-8);\n}\n\n.page-header h2 {\n    font-size: var(--font-size-3xl);\n    font-weight: var(--font-weight-bold);\n    color: var(--text-primary);\n    margin-bottom: var(--space-2);\n}\n\n.page-header p {\n    color: var(--text-secondary);\n    font-size: var(--font-size-lg);\n    margin-bottom: var(--space-6);\n}\n\n.page-actions {\n    display: flex;\n    gap: var(--space-4);\n    flex-wrap: wrap;\n}\n\n/* =============================================================================\n   DASHBOARD LAYOUT\n   ============================================================================= */\n\n.dashboard-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n    gap: var(--space-6);\n    margin-bottom: var(--space-8);\n}\n\n.quick-actions {\n    display: flex;\n    flex-direction: column;\n    gap: var(--space-3);\n}\n\n/* =============================================================================\n   DATASET MANAGEMENT LAYOUT\n   ============================================================================= */\n\n.dataset-controls {\n    margin-bottom: var(--space-6);\n}\n\n.search-filter-bar {\n    display: flex;\n    gap: var(--space-4);\n    align-items: center;\n    flex-wrap: wrap;\n}\n\n.search-box {\n    position: relative;\n    flex: 1;\n    min-width: 300px;\n}\n\n.search-icon {\n    position: absolute;\n    left: var(--space-4);\n    top: 50%;\n    transform: translateY(-50%);\n    color: var(--text-tertiary);\n    pointer-events: none;\n}\n\n.filter-controls {\n    display: flex;\n    gap: var(--space-3);\n    flex-wrap: wrap;\n}\n\n.dataset-content {\n    background-color: var(--bg-secondary);\n    border: 1px solid var(--border-light);\n    border-radius: var(--radius-xl);\n    min-height: 400px;\n    padding: var(--space-6);\n}\n\n/* =============================================================================\n   STATUS BAR\n   ============================================================================= */\n\n.status-bar {\n    grid-area: status;\n    background-color: var(--bg-tertiary);\n    border-top: 1px solid var(--border-light);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 var(--space-6);\n    font-size: var(--font-size-xs);\n    color: var(--text-tertiary);\n}\n\n.status-left,\n.status-right {\n    display: flex;\n    align-items: center;\n    gap: var(--space-2);\n}\n\n.status-indicator {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    display: inline-block;\n}\n\n.status-text {\n    font-size: var(--font-size-xs);\n}\n\n/* =============================================================================\n   AUTH MODAL LAYOUT\n   ============================================================================= */\n\n.auth-switch {\n    text-align: center;\n    margin-top: var(--space-6);\n    color: var(--text-secondary);\n    font-size: var(--font-size-sm);\n}\n\n.auth-switch .btn-link {\n    margin-left: var(--space-2);\n}\n\n/* =============================================================================\n   UTILITY CLASSES\n   ============================================================================= */\n\n.full-width {\n    width: 100%;\n}\n\n.text-center {\n    text-align: center;\n}\n\n.text-left {\n    text-align: left;\n}\n\n.text-right {\n    text-align: right;\n}\n\n.flex {\n    display: flex;\n}\n\n.flex-col {\n    flex-direction: column;\n}\n\n.items-center {\n    align-items: center;\n}\n\n.justify-center {\n    justify-content: center;\n}\n\n.justify-between {\n    justify-content: space-between;\n}\n\n.gap-2 { gap: var(--space-2); }\n.gap-3 { gap: var(--space-3); }\n.gap-4 { gap: var(--space-4); }\n.gap-6 { gap: var(--space-6); }\n\n.mt-2 { margin-top: var(--space-2); }\n.mt-4 { margin-top: var(--space-4); }\n.mt-6 { margin-top: var(--space-6); }\n.mb-2 { margin-bottom: var(--space-2); }\n.mb-4 { margin-bottom: var(--space-4); }\n.mb-6 { margin-bottom: var(--space-6); }\n\n.p-2 { padding: var(--space-2); }\n.p-4 { padding: var(--space-4); }\n.p-6 { padding: var(--space-6); }\n\n.hidden {\n    display: none !important;\n}\n\n.invisible {\n    visibility: hidden;\n}\n\n.opacity-0 {\n    opacity: 0;\n}\n\n.opacity-50 {\n    opacity: 0.5;\n}\n\n.pointer-events-none {\n    pointer-events: none;\n}"
          },
