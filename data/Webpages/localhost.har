            "mimeType": "text/css",
            "compression": 0,
            "text": "/* Responsive Design for TailerAI v2.0 */\n\n/* =============================================================================\n   MOBILE FIRST APPROACH\n   ============================================================================= */\n\n/* Extra Small Devices (phones, less than 640px) */\n@media (max-width: 639px) {\n    .app-shell {\n        grid-template-areas: \n            \"header\"\n            \"main\"\n            \"status\";\n        grid-template-columns: 1fr;\n        grid-template-rows: var(--header-height) 1fr var(--status-bar-height);\n    }\n\n    .app-sidebar {\n        position: fixed;\n        top: var(--header-height);\n        left: 0;\n        width: 100%;\n        height: calc(100vh - var(--header-height) - var(--status-bar-height));\n        z-index: var(--z-dropdown);\n        transform: translateX(-100%);\n        transition: transform var(--transition-normal);\n        grid-area: unset;\n    }\n\n    .app-sidebar.mobile-open {\n        transform: translateX(0);\n    }\n\n    .sidebar-overlay {\n        position: fixed;\n        top: var(--header-height);\n        left: 0;\n        width: 100%;\n        height: calc(100vh - var(--header-height) - var(--status-bar-height));\n        background-color: rgba(0, 0, 0, 0.5);\n        z-index: calc(var(--z-dropdown) - 1);\n        opacity: 0;\n        visibility: hidden;\n        transition: all var(--transition-normal);\n    }\n\n    .sidebar-overlay.active {\n        opacity: 1;\n        visibility: visible;\n    }\n\n    .header-center {\n        display: none;\n    }\n\n    .app-logo h1 {\n        font-size: var(--font-size-lg);\n    }\n\n    .app-subtitle {\n        display: none;\n    }\n\n    .view {\n        padding: var(--space-4);\n    }\n\n    .page-header h2 {\n        font-size: var(--font-size-2xl);\n    }\n\n    .dashboard-grid {\n        grid-template-columns: 1fr;\n        gap: var(--space-4);\n    }\n\n    .search-filter-bar {\n        flex-direction: column;\n        align-items: stretch;\n    }\n\n    .search-box {\n        min-width: unset;\n    }\n\n    .filter-controls {\n        justify-content: space-between;\n    }\n\n    .page-actions {\n        flex-direction: column;\n    }\n\n    .modal-content {\n        width: 95%;\n        margin: var(--space-4);\n    }\n\n    .notifications-container {\n        top: calc(var(--header-height) + var(--space-2));\n        right: var(--space-2);\n        left: var(--space-2);\n        max-width: unset;\n    }\n\n    .status-bar {\n        padding: 0 var(--space-4);\n    }\n\n    .status-left,\n    .status-right {\n        font-size: var(--font-size-xs);\n    }\n\n    .status-right {\n        display: none;\n    }\n}\n\n/* Small Devices (large phones, 640px and up) */\n@media (min-width: 640px) and (max-width: 767px) {\n    .app-shell {\n        grid-template-columns: var(--sidebar-collapsed-width) 1fr;\n    }\n\n    .nav-text {\n        display: none;\n    }\n\n    .nav-link {\n        justify-content: center;\n        padding: var(--space-3);\n    }\n\n    .sidebar-content {\n        padding: var(--space-6) var(--space-2);\n    }\n\n    .header-center {\n        display: flex;\n    }\n\n    .breadcrumb {\n        font-size: var(--font-size-xs);\n    }\n\n    .view {\n        padding: var(--space-6);\n    }\n\n    .dashboard-grid {\n        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n    }\n\n    .search-filter-bar {\n        flex-wrap: wrap;\n    }\n\n    .search-box {\n        min-width: 250px;\n        flex: 1 1 250px;\n    }\n}\n\n/* Medium Devices (tablets, 768px and up) */\n@media (min-width: 768px) and (max-width: 1023px) {\n    .dashboard-grid {\n        grid-template-columns: repeat(2, 1fr);\n    }\n\n    .search-filter-bar {\n        flex-wrap: nowrap;\n    }\n\n    .search-box {\n        min-width: 300px;\n    }\n}\n\n/* Large Devices (desktops, 1024px and up) */\n@media (min-width: 1024px) {\n    .dashboard-grid {\n        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\n    }\n\n    .view {\n        padding: var(--space-8);\n    }\n}\n\n/* Extra Large Devices (large desktops, 1280px and up) */\n@media (min-width: 1280px) {\n    .view {\n        max-width: 1200px;\n        margin: 0 auto;\n        padding: var(--space-8) var(--space-12);\n    }\n\n    .dashboard-grid {\n        grid-template-columns: repeat(4, 1fr);\n    }\n}\n\n/* =============================================================================\n   LANDSCAPE ORIENTATION ADJUSTMENTS\n   ============================================================================= */\n\n@media (orientation: landscape) and (max-height: 600px) {\n    .view {\n        padding: var(--space-4);\n    }\n\n    .page-header {\n        margin-bottom: var(--space-4);\n    }\n\n    .page-header h2 {\n        font-size: var(--font-size-xl);\n        margin-bottom: var(--space-1);\n    }\n\n    .page-header p {\n        font-size: var(--font-size-base);\n        margin-bottom: var(--space-3);\n    }\n\n    .dashboard-grid {\n        gap: var(--space-4);\n    }\n\n    .dashboard-card {\n        padding: var(--space-4);\n    }\n}\n\n/* =============================================================================\n   HIGH DPI DISPLAYS\n   ============================================================================= */\n\n@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {\n    .loading-spinner {\n        border-width: 2px;\n    }\n\n    .progress-bar {\n        height: 6px;\n    }\n\n    .status-indicator {\n        width: 6px;\n        height: 6px;\n    }\n}\n\n/* =============================================================================\n   PRINT STYLES\n   ============================================================================= */\n\n@media print {\n    .app-header,\n    .app-sidebar,\n    .status-bar,\n    .notifications-container {\n        display: none !important;\n    }\n\n    .app-shell {\n        grid-template-areas: \"main\";\n        grid-template-columns: 1fr;\n        grid-template-rows: 1fr;\n    }\n\n    .view {\n        padding: 0;\n        box-shadow: none;\n        border: none;\n    }\n\n    .page-header {\n        margin-bottom: var(--space-4);\n    }\n\n    .dashboard-card,\n    .card {\n        box-shadow: none;\n        border: 1px solid var(--border-primary);\n        break-inside: avoid;\n    }\n\n    .btn {\n        display: none;\n    }\n\n    body {\n        background: white;\n        color: black;\n    }\n}\n\n/* =============================================================================\n   REDUCED MOTION\n   ============================================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n    *,\n    *::before,\n    *::after {\n        animation-duration: 0.01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: 0.01ms !important;\n        scroll-behavior: auto !important;\n    }\n\n    .view {\n        transform: none !important;\n    }\n\n    .modal-content {\n        transform: none !important;\n    }\n\n    .notification {\n        transform: none !important;\n    }\n\n    .loading-spinner {\n        animation: none;\n        border-top-color: var(--accent-primary);\n    }\n}\n\n/* =============================================================================\n   CONTAINER QUERIES (Future Enhancement)\n   ============================================================================= */\n\n/* When container queries are widely supported, these can be used for more granular responsive design */\n\n/* @container sidebar (max-width: 200px) {\n    .nav-text {\n        display: none;\n    }\n    \n    .nav-link {\n        justify-content: center;\n    }\n} */\n\n/* =============================================================================\n   ACCESSIBILITY ENHANCEMENTS\n   ============================================================================= */\n\n/* Increase spacing for easier touch targets on mobile */\n@media (max-width: 767px) {\n    .btn {\n        min-height: 44px;\n        padding: var(--space-3) var(--space-6);\n    }\n\n    .nav-link {\n        min-height: 44px;\n        padding: var(--space-4);\n    }\n\n    .user-avatar {\n        width: 44px;\n        height: 44px;\n    }\n\n    .sidebar-toggle {\n        width: 44px;\n        height: 44px;\n    }\n\n    .modal-close {\n        width: 44px;\n        height: 44px;\n    }\n\n    .form-group input,\n    .form-group textarea,\n    .form-group select {\n        min-height: 44px;\n        padding: var(--space-3) var(--space-4);\n    }\n}\n\n/* Focus indicators for keyboard navigation */\n@media (hover: none) and (pointer: coarse) {\n    .btn:focus,\n    .nav-link:focus,\n    input:focus,\n    textarea:focus,\n    select:focus {\n        outline: 3px solid var(--accent-primary);\n        outline-offset: 2px;\n    }\n}\n\n/* Enhanced contrast for better readability */\n@media (prefers-contrast: high) {\n    .btn-outline {\n        border-width: 2px;\n    }\n\n    .card,\n    .dashboard-card {\n        border-width: 2px;\n    }\n\n    .form-group input,\n    .form-group textarea,\n    .form-group select {\n        border-width: 2px;\n    }\n\n    .nav-link.active {\n        outline: 2px solid var(--text-inverse);\n        outline-offset: -2px;\n    }\n}"
