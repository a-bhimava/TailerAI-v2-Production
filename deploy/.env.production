# TailerAI v2.0 - Production Environment Variables for Google Cloud Run
# This file contains all production environment variables
# Copy values to Google Secret Manager for secure deployment

# ===============================
# APPLICATION SETTINGS
# ===============================
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
APP_NAME=TailerAI v2.0

# ===============================
# SERVER CONFIGURATION
# ===============================
HOST=0.0.0.0
PORT=8080

# ===============================
# DATABASE CONFIGURATION
# ===============================
# SQLite (default - for simple deployments)
DATABASE_URL=sqlite:///./data/database/tailer_v2.db

# PostgreSQL Cloud SQL (uncomment for production database)
# DATABASE_URL=postgresql://tailerai_user:PASSWORD@/tailerai_production?host=/cloudsql/PROJECT_ID:us-central1:tailerai-db

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600

# ===============================
# AI SERVICE CONFIGURATION
# ===============================
# Store in Google Secret Manager: tailerai-gemini-api-key
GEMINI_API_KEY=your_gemini_api_key_here

# Rate limiting for AI services
GEMINI_REQUESTS_PER_MINUTE=60
GEMINI_DAILY_LIMIT=1500

# AI feature flags
ENABLE_AI_CONTENT_SELECTION=true
ENABLE_AI_ATS_OPTIMIZATION=true
ENABLE_AI_CONTENT_ENHANCEMENT=true
ENABLE_AI_PERSONALIZATION=true

# AI confidence thresholds
AI_SELECTION_CONFIDENCE_THRESHOLD=0.7
ATS_OPTIMIZATION_CONFIDENCE_THRESHOLD=0.7
CONTENT_ENHANCEMENT_CONFIDENCE_THRESHOLD=0.7
PERSONALIZATION_CONFIDENCE_THRESHOLD=0.7

# ===============================
# LATEX CONFIGURATION
# ===============================
LATEX_ENGINE=tectonic
LATEX_ENGINE_PATH=/usr/local/bin/tectonic
LATEX_TEMPLATE_DIR=./templates/latex
DEFAULT_TEMPLATE=mspm_template.tex

# ===============================
# SECURITY SETTINGS
# ===============================
# Store in Google Secret Manager: tailerai-secret-key
SECRET_KEY=your_secret_key_change_in_production

# Store in Google Secret Manager: tailerai-jwt-secret
JWT_SECRET_KEY=your_jwt_secret_change_in_production

# ===============================
# PERFORMANCE SETTINGS
# ===============================
MAX_FILE_SIZE=10485760  # 10MB
REQUEST_TIMEOUT=300
MAX_WORKERS=1

# ===============================
# STORAGE CONFIGURATION
# ===============================
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/generated
CACHE_DIR=./data/cache

# ===============================
# CORS CONFIGURATION
# ===============================
ALLOWED_ORIGINS=https://tailerai-v2-YOUR_PROJECT_ID.run.app,https://yourdomain.com

# ===============================
# FRONTEND CONFIGURATION
# ===============================
FRONTEND_URL=https://tailerai-v2-YOUR_PROJECT_ID.run.app

# ===============================
# GOOGLE OAUTH CONFIGURATION
# ===============================
GOOGLE_CLIENT_ID=your_google_client_id_here
# Store in Google Secret Manager: tailerai-google-client-secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://tailerai-v2-YOUR_PROJECT_ID.run.app

# ===============================
# MONITORING & LOGGING
# ===============================
TRACK_LEARNING_EVENTS=true
LEARNING_EVENT_RETENTION_DAYS=365
AUTO_REANALYZE_TRIGGER_COUNT=3

# ===============================
# A/B TESTING SETTINGS
# ===============================
ENABLE_AB_TESTING=false
AB_TEST_DEFAULT_DURATION_DAYS=30
AB_TEST_MIN_SAMPLE_SIZE=100
AB_TEST_CONFIDENCE_LEVEL=0.95

# ===============================
# MARKET INTELLIGENCE
# ===============================
ENABLE_MARKET_INTELLIGENCE=false
MARKET_INTELLIGENCE_REFRESH_HOURS=24
MARKET_INTELLIGENCE_DATA_SOURCES=user_outcomes,gemini_analysis

# ===============================
# EMAIL CONFIGURATION (Optional)
# ===============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ===============================
# RATE LIMITING
# ===============================
REQUESTS_PER_MINUTE=60

# ===============================
# FALLBACK SETTINGS
# ===============================
AI_SELECTION_FALLBACK_ENABLED=true
ATS_OPTIMIZATION_FALLBACK_ENABLED=true
CONTENT_ENHANCEMENT_FALLBACK_ENABLED=true
PERSONALIZATION_FALLBACK_ENABLED=true

# ===============================
# PERSONALIZATION SETTINGS
# ===============================
PERSONALIZATION_MIN_DATA_POINTS=5
PERSONALIZATION_LEARNING_WINDOW_DAYS=365

# ===============================
# CONTENT ENHANCEMENT SETTINGS
# ===============================
CONTENT_ENHANCEMENT_DEFAULT_LEVEL=moderate

# ===============================
# ATS OPTIMIZATION SETTINGS
# ===============================
ATS_DEFAULT_TARGET_SYSTEMS=taleo,workday,generic

# ===============================
# AI CONTENT SELECTION SETTINGS
# ===============================
AI_SELECTION_DEFAULT_METHOD=ai_enhanced